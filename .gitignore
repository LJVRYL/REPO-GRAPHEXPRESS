# Ignorar core de WordPress
/wp-admin/
/wp-includes/

# Ignorar contenido subido por usuarios
/wp-content/uploads/

# Ignorar themes que no sean el child nuestro
/wp-content/themes/*
!/wp-content/themes/printing-services-child/

# Ignorar plugins que no sean el nuestro
/wp-content/plugins/*
!/wp-content/plugins/ge-webtoprint-calculator/

# Ignorar archivos de configuración sensibles
wp-config.php
wp-config-local.php

# Ignorar backups y archivos temporales
*.log
*.tmp
*.swp
*.swo
*.bak
*.old
*.zip
wp-content/plugins/ge-webtoprint-calculator/data/*-costs.local.json
wp-content/plugins/ge-webtoprint-calculator/includes/*.costs.local.php
*Diagnostics.md

# Imágenes de referencia descargadas; el catálogo usa solamente /generated.
wp-content/plugins/ge-webtoprint-calculator/assets/images/products/*
!wp-content/plugins/ge-webtoprint-calculator/assets/images/products/generated/
!wp-content/plugins/ge-webtoprint-calculator/assets/images/products/generated/**

# Ignorar cosas de sistema
.DS_Store
Thumbs.db

# Ignorar carpetas de IDEs/editores
.vscode/
.idea/
*.code-workspace

# --- Allow GraphExpress child theme to be versioned ---
!wp-content/themes/graphexpress-child/
!wp-content/themes/graphexpress-child/**
