  "calculation_rules":{
    "net_paper_mass_kg":"quantity * validated_net_area_m2 * validated_grammage_g_m2 / 1000; sum sheets/parts where applicable",
    "finished_net_mass":"paper estimate plus documented validated accessories/coatings; prefer measured sample",
    "package_count":"ceil(quantity / validated_units_per_package); compute remainder package separately",
    "gross_mass":"net_finished_mass_of_package + measured_packaging_tare_kg",
    "volumetric_mass":"external_length_cm * external_width_cm * external_height_cm / carrier_documented_divisor",
    "chargeable_mass":"carrier-specific rule from logistics worker; never assume divisor or rounding"
  },
  "validation":{
    "required_evidence":["product variant and quantity", "calculation assumptions and source", "representative sample weight", "external packed dimensions", "packaging tare", "units per package and remainder", "measurement date and responsible person", "carrier contract divisor/rounding owned by logistics"],
